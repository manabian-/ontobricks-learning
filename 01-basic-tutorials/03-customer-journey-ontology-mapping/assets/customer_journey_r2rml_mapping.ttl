map:TriplesMap_Interaction a rr:TriplesMap ;
    rdfs:comment "Mapping for Interaction to https://databricks-ontology.com/CustomerJourney#Interaction" ;
    rr:logicalTable [
        rr:sqlQuery """SELECT
    interaction_id AS interactionId,
    CONCAT(interaction_id, ' - ', interaction_type) AS label,
    interaction_id AS interactionIdAttr,
    customer_id AS customerId,
    channel,
    interaction_type AS interactionType,
    TRY_CAST(interaction_datetime AS TIMESTAMP) AS interactionDatetime,
    subject,
    outcome,
    agent_id AS agentId,
    duration_minutes AS durationMinutes,
    sentiment
FROM ontobricks.customer_journey.interaction"""
    ] ;
    rr:subjectMap [
        rr:template "https://databricks-ontology.com/CustomerJourney/Interaction/{interactionId}" ;
        rr:class ont:Interaction ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap
    [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "label" ]
    ],
    [
        rr:predicate interaction:interactionId ;
        rr:objectMap [ rr:column "interactionIdAttr" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:customerId ;
        rr:objectMap [ rr:column "customerId" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:channel ;
        rr:objectMap [ rr:column "channel" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:interactionType ;
        rr:objectMap [ rr:column "interactionType" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:interactionDatetime ;
        rr:objectMap [ rr:column "interactionDatetime" ; rr:datatype xsd:dateTime ]
    ],
    [
        rr:predicate interaction:subject ;
        rr:objectMap [ rr:column "subject" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:outcome ;
        rr:objectMap [ rr:column "outcome" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:agentId ;
        rr:objectMap [ rr:column "agentId" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate interaction:durationMinutes ;
        rr:objectMap [ rr:column "durationMinutes" ; rr:datatype xsd:integer ]
    ],
    [
        rr:predicate interaction:sentiment ;
        rr:objectMap [ rr:column "sentiment" ; rr:datatype xsd:string ]
    ] .

