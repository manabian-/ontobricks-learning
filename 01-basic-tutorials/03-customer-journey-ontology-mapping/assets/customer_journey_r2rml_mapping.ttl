@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ont: <https://databricks-ontology.com/CustomerJourney#> .
@prefix map: <https://databricks-ontology.com/CustomerJourney/mapping/> .
@prefix customer: <https://databricks-ontology.com/CustomerJourney/property/Customer/> .
@prefix contract: <https://databricks-ontology.com/CustomerJourney/property/Contract/> .
@prefix subscription: <https://databricks-ontology.com/CustomerJourney/property/Subscription/> .
@prefix meter: <https://databricks-ontology.com/CustomerJourney/property/Meter/> .
@prefix meterreading: <https://databricks-ontology.com/CustomerJourney/property/MeterReading/> .
@prefix invoice: <https://databricks-ontology.com/CustomerJourney/property/Invoice/> .
@prefix payment: <https://databricks-ontology.com/CustomerJourney/property/Payment/> .
@prefix call: <https://databricks-ontology.com/CustomerJourney/property/Call/> .
@prefix claim: <https://databricks-ontology.com/CustomerJourney/property/Claim/> .
@prefix interaction: <https://databricks-ontology.com/CustomerJourney/property/Interaction/> .

# R2RML mapping for ontobricks.customer_journey
# Target ontology: Customer Journey Ontology (Energy Provider)
# Physical source columns use snake_case; SQL output aliases and OWL attribute
# local names use lowerCamelCase.
# Coverage: 10 entity maps, 100 datatype-property maps, 10 label maps,
#           and 10 relationship maps.

# -----------------------------------------------------------------------------
# Entity: Customer
# -----------------------------------------------------------------------------

map:TriplesMap_Customer a rr:TriplesMap ;
    rdfs:comment "Mapping for Customer to https://databricks-ontology.com/CustomerJourney#Customer" ;
    rr:logicalTable [
        rr:sqlQuery """SELECT
    customer_id AS customerId,
    CONCAT(first_name, ' ', last_name) AS label,
    customer_id AS customerIdAttr,
    first_name AS firstName,
    last_name AS lastName,
    email,
    phone,
    street_address AS streetAddress,
    city,
    postal_code AS postalCode,
    country,
    TRY_CAST(date_of_birth AS DATE) AS dateOfBirth,
    TRY_CAST(registration_date AS DATE) AS registrationDate,
    segment,
    loyalty_points AS loyaltyPoints,
    TRY_CAST(is_active AS BOOLEAN) AS isActive
FROM ontobricks.customer_journey.customer"""
    ] ;
    rr:subjectMap [
        rr:template "https://databricks-ontology.com/CustomerJourney/Customer/{customerId}" ;
        rr:class ont:Customer ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap
    [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "label" ]
    ],
    [
        rr:predicate customer:customerId ;
        rr:objectMap [ rr:column "customerIdAttr" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:firstName ;
        rr:objectMap [ rr:column "firstName" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:lastName ;
        rr:objectMap [ rr:column "lastName" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:email ;
        rr:objectMap [ rr:column "email" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:phone ;
        rr:objectMap [ rr:column "phone" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:streetAddress ;
        rr:objectMap [ rr:column "streetAddress" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:city ;
        rr:objectMap [ rr:column "city" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:postalCode ;
        rr:objectMap [ rr:column "postalCode" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:country ;
        rr:objectMap [ rr:column "country" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:dateOfBirth ;
        rr:objectMap [ rr:column "dateOfBirth" ; rr:datatype xsd:date ]
    ],
    [
        rr:predicate customer:registrationDate ;
        rr:objectMap [ rr:column "registrationDate" ; rr:datatype xsd:date ]
    ],
    [
        rr:predicate customer:segment ;
        rr:objectMap [ rr:column "segment" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate customer:loyaltyPoints ;
        rr:objectMap [ rr:column "loyaltyPoints" ; rr:datatype xsd:integer ]
    ],
    [
        rr:predicate customer:isActive ;
        rr:objectMap [ rr:column "isActive" ; rr:datatype xsd:boolean ]
    ] .

# -----------------------------------------------------------------------------
# Entity: Contract
# -----------------------------------------------------------------------------

map:TriplesMap_Contract a rr:TriplesMap ;
    rdfs:comment "Mapping for Contract to https://databricks-ontology.com/CustomerJourney#Contract" ;
    rr:logicalTable [
        rr:sqlQuery """SELECT
    contract_id AS contractId,
    CONCAT(contract_id, ' - ', energy_type) AS label,
    contract_id AS contractIdAttr,
    customer_id AS customerId,
    energy_type AS energyType,
    TRY_CAST(start_date AS DATE) AS startDate,
    TRY_CAST(end_date AS DATE) AS endDate,
    status,
    monthly_fee AS monthlyFee,
    payment_method AS paymentMethod,
    TRY_CAST(auto_renewal AS BOOLEAN) AS autoRenewal,
    TRY_CAST(created_at AS DATE) AS createdAt
FROM ontobricks.customer_journey.contract"""
    ] ;
    rr:subjectMap [
        rr:template "https://databricks-ontology.com/CustomerJourney/Contract/{contractId}" ;
        rr:class ont:Contract ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap
    [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "label" ]
    ],
    [
        rr:predicate contract:contractId ;
        rr:objectMap [ rr:column "contractIdAttr" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate contract:customerId ;
        rr:objectMap [ rr:column "customerId" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate contract:energyType ;
        rr:objectMap [ rr:column "energyType" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate contract:startDate ;
        rr:objectMap [ rr:column "startDate" ; rr:datatype xsd:date ]
    ],
    [
        rr:predicate contract:endDate ;
        rr:objectMap [ rr:column "endDate" ; rr:datatype xsd:date ]
    ],
    [
        rr:predicate contract:status ;
        rr:objectMap [ rr:column "status" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate contract:monthlyFee ;
        rr:objectMap [ rr:column "monthlyFee" ; rr:datatype xsd:decimal ]
    ],
    [
        rr:predicate contract:paymentMethod ;
        rr:objectMap [ rr:column "paymentMethod" ; rr:datatype xsd:string ]
    ],
    [
        rr:predicate contract:autoRenewal ;
        rr:objectMap [ rr:column "autoRenewal" ; rr:datatype xsd:boolean ]
    ],
    [
        rr:predicate contract:createdAt ;
        rr:objectMap [ rr:column "createdAt" ; rr:datatype xsd:date ]
    ] .

