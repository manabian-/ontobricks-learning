map:TriplesMap_Rel_hasContract a rr:TriplesMap ;
    rdfs:comment "Relationship mapping: Customer --hasContract--> Contract" ;
    rr:logicalTable [
        rr:sqlQuery """SELECT
    customer_id AS customerId,
    contract_id AS contractId
FROM ontobricks.customer_journey.contract
WHERE customer_id IS NOT NULL AND contract_id IS NOT NULL"""
    ] ;
    rr:subjectMap [
        rr:template "https://databricks-ontology.com/CustomerJourney/Customer/{customerId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate ont:hasContract ;
        rr:objectMap [
            rr:template "https://databricks-ontology.com/CustomerJourney/Contract/{contractId}" ;
            rr:termType rr:IRI
        ]
    ] .

